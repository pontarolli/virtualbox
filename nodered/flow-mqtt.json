    "type": "function",
    "name": "simula leitura do sensor",
    "func": "// o topico tambem pode vir da mensagem:\n// o no mqtt out usa msg.topic quando o campo Topic dele esta vazio\nmsg.topic = \"lab/sensor/sala-01\";\nmsg.payload = {\n    sensor: \"sala-01\",\n    temperatura: Number((20 + Math.random() * 10).toFixed(1)),\n    umidade:     Number((40 + Math.random() * 20).toFixed(1)),\n    horario:     new Date().toISOString()\n};\nreturn msg;\n",
