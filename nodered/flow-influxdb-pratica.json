    {
        "id": "x_fn1",
        "type": "function",
        "z": "tab_influx_pratica",
        "name": "monta o ponto",
        "func": "// O no 'influxdb out' espera:\n//   msg.payload = [ {fields}, {tags} ]\n// fields = valores medidos | tags = rotulos usados para filtrar/agrupar\nmsg.payload = [\n    {\n        temperatura: Number((20 + Math.random() * 10).toFixed(1)),\n        umidade:     Number((40 + Math.random() * 20).toFixed(1))\n    },\n    { sensor: \"sala-01\", predio: \"A\" }\n];\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 140,
        "wires": [
            [
                "x_out"
            ]
        ]
    },
    {
        "id": "x_i2",
        "type": "inject",
        "z": "tab_influx_pratica",
        "name": "2 - Gravar 20 leituras (historico)",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
