    {
        "id": "x_fn2",
        "type": "function",
        "z": "tab_influx_pratica",
        "name": "20 pontos nos ultimos 20 min",
        "func": "// Uma mensagem por ponto, com horario proprio (msg.payload[0].time)\nconst agora = Date.now();\nconst msgs = [];\nfor (let i = 19; i >= 0; i--) {\n    msgs.push({ payload: [\n        {\n            temperatura: Number((22 + Math.sin(i / 3) * 4 + Math.random()).toFixed(1)),\n            umidade:     Number((50 + Math.cos(i / 4) * 8 + Math.random()).toFixed(1)),\n            time:        new Date(agora - i * 60000)\n        },\n        { sensor: \"sala-02\", predio: \"A\" }\n    ]});\n}\nreturn [msgs];\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 220,
        "wires": [
            [
                "x_out"
            ]
        ]
    },
