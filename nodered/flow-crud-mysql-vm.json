  {
    "id": "crudmysql_fn_criar",
    "type": "function",
    "name": "DROP + CREATE TABLE",
    "func": "// O no mysql executa UMA instrucao SQL por mensagem.\n// Entao emitimos uma mensagem para cada comando, na ordem.\nconst comandos = [\n    \"DROP TABLE IF EXISTS books\",\n    \"DROP TABLE IF EXISTS authors\",\n    \"CREATE TABLE authors (author_id INT AUTO_INCREMENT PRIMARY KEY, name_last VARCHAR(50), name_first VARCHAR(50), country VARCHAR(50))\",\n    \"CREATE TABLE books (isbn CHAR(20) PRIMARY KEY, title VARCHAR(50), author_id INT, publisher_id INT, year_pub CHAR(4), description TEXT)\"\n];\n\n// retorna um array de mensagens na mesma saida\nreturn [ comandos.map(sql => ({ topic: sql, payload: [] })) ];\n",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 220,
    "wires": [ [ "crudmysql_db_1" ] ],
    "z": "tab_crud_mysql_host"
  },
