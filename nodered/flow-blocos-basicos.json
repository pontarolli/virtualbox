  {
    "id": "b_fn",
    "type": "function",
    "name": "dobra e descreve",
    "func": "// no function voce escreve JavaScript.\n// msg e a mensagem que entrou; o que voce retornar segue no flow.\nconst n = msg.payload;\nmsg.payload = { original: n, dobro: n * 2, par: n % 2 === 0 };\nreturn msg;\n",
