    {
        "id": "x_fn3",
        "type": "function",
        "z": "tab_influx_ponte",
        "name": "MQTT -> ponto do Influx",
        "func": "// payload que chega do MQTT:\n//   { sensor, temperatura, umidade, horario }\nconst d = msg.payload;\nmsg.payload = [\n    { temperatura: d.temperatura, umidade: d.umidade },\n    { sensor: d.sensor, origem: \"mqtt\" }\n];\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 560,
        "wires": [
            [
                "x_out2"
            ]
        ]
    },
    {
        "id": "x_out2",
        "type": "influxdb out",
        "z": "tab_influx_ponte",
        "influxdb": "cfg_ponte_influx",
        "name": "grava o que veio do MQTT",
        "measurement": "leituras",
        "precision": "",
        "retentionPolicy": "",
        "database": "database",
        "precisionV18FluxV20": "ms",
        "retentionPolicyV18Flux": "",
